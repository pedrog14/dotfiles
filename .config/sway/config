# Environment Variables
exec systemctl --user set-environment QT_QPA_PLATFORMTHEME=gtk3
exec systemctl --user set-environment PROTON_ENABLE_WAYLAND=1

# Variables
set $left  h
set $down  j
set $up    k
set $right l
set $mod   Mod4

# Autostart
exec {
  noctalia
  autotiling
}

# Input
input "1:1:AT_Translated_Set_2_keyboard" {
  xkb_layout  br
  xkb_options caps:escape
  xkb_numlock enabled
}
exec ibus start

input type:pointer {
  accel_profile flat
}

input type:touchpad {
  tap            enabled
  drag_lock      enabled
  natural_scroll enabled
}

# Window Rules
for_window {
  [app_id="org.gnome.Calculator"] floating enable
}

# Bindings
bindsym {
  $mod+Return  exec ghostty
  $mod+d       exec noctalia msg panel-toggle launcher
  $mod+e       exec noctalia msg panel-toggle session
  $mod+q       kill
  $mod+c       reload

  $mod+$left  focus left
  $mod+$down  focus down
  $mod+$up    focus up
  $mod+$right focus right

  $mod+Shift+$left  move left
  $mod+Shift+$down  move down
  $mod+Shift+$up    move up
  $mod+Shift+$right move right

  $mod+1 workspace number 1
  $mod+2 workspace number 2
  $mod+3 workspace number 3
  $mod+4 workspace number 4
  $mod+5 workspace number 5
  $mod+6 workspace number 6
  $mod+7 workspace number 7
  $mod+8 workspace number 8
  $mod+9 workspace number 9
  $mod+0 workspace number 10

  $mod+Shift+1 move container to workspace number 1
  $mod+Shift+2 move container to workspace number 2
  $mod+Shift+3 move container to workspace number 3
  $mod+Shift+4 move container to workspace number 4
  $mod+Shift+5 move container to workspace number 5
  $mod+Shift+6 move container to workspace number 6
  $mod+Shift+7 move container to workspace number 7
  $mod+Shift+8 move container to workspace number 8
  $mod+Shift+9 move container to workspace number 9
  $mod+Shift+0 move container to workspace number 10

  $mod+b splith
  $mod+v splitv
  $mod+n layout toggle split

  $mod+s layout stacking
  $mod+w layout tabbed

  $mod+f fullscreen

  $mod+t floating toggle
  $mod+Shift+t focus mode_toggle

  $mod+a focus parent

  $mod+Shift+minus move scratchpad
  $mod+minus scratchpad show

  $mod+r mode 'resize'

  XF86MonBrightnessDown exec brightnessctl set 5%-
  XF86MonBrightnessUp   exec brightnessctl set 5%+

  XF86AudioMute        exec wpctl set-mute   @DEFAULT_SINK@ toggle
  XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_SINK@ 5%-
  XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_SINK@ 5%+ -l 1.0

  XF86AudioPlay exec playerctl play-pause
  XF86AudioStop exec playerctl stop
  XF86AudioPrev exec playerctl previous
  XF86AudioNext exec playerctl next

  XF86PowerOff exec noctalia msg panel-toggle session

  Print  exec noctalia exec screenshot-fullscreen
  $mod+p exec noctalia exec screenshot-region
}

mode 'resize' {
  bindsym {
    $left  resize shrink width  10px
    $down  resize grow   height 10px
    $up    resize shrink height 10px
    $right resize grow   width  10px

    Return mode 'default'
    Escape mode 'default'
  }
}

floating_modifier $mod normal

# Appearance
default_border pixel 2
gaps inner 8
font pango: Fira Code 9

exec bash -c "~/.config/gtk-4.0/settings.sh" # GTK 4.0 Settings
seat seat0 xcursor_theme 'Simp1e-Gruvbox-Dark'

include colorschemes/gruvbox/dark

# target                 title bg    text  indicator     border
client.background              $bg0
client.focused           $blue $blue $fg1  $neutral_blue $blue
client.focused_inactive  $bg1  $bg2  $fg1  $bg1          $bg2
client.focused_tab_title $bg1  $bg2  $fg1
client.unfocused         $bg0  $bg1  $gray $bg0          $bg1
client.urgent            $red  $red  $fg1  $neutral_red  $red
client.placeholder       $bg1  $bg2  $fg1  $bg1          $bg2

include swayfx
include /etc/sway/config.d/*
